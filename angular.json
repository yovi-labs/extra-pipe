{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "extra-pipe": {
      "projectType": "library",
      "root": "projects/extra-pipe",
      "sourceRoot": "projects/extra-pipe/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/extra-pipe/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/extra-pipe/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/extra-pipe/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/extra-pipe/src/test.ts",
            "tsConfig": "projects/extra-pipe/tsconfig.spec.json",
            "karmaConfig": "projects/extra-pipe/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": ".eslintrc",
            "lintFilePatterns": ["projects/extra-pipe/src/**/*.ts"]
          }
        }
      }
    },
    "angular17-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/angular17-demo",
      "sourceRoot": "projects/angular17-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/angular17-demo",
            "index": "projects/angular17-demo/src/index.html",
            "main": "projects/angular17-demo/src/main.ts",
            "polyfills": "projects/angular17-demo/src/polyfills.ts",
            "tsConfig": "projects/angular17-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/angular17-demo/src/favicon.ico",
              "projects/angular17-demo/src/assets"
            ],
            "styles": ["projects/angular17-demo/src/styles.scss"],
            "scripts": [],
            "aot": true
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/angular17-demo/src/environments/environment.ts",
                  "with": "projects/angular17-demo/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular17-demo:build:production"
            },
            "development": {
              "buildTarget": "angular17-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "angular17-demo:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/angular17-demo/src/test.ts",
            "polyfills": "projects/angular17-demo/src/polyfills.ts",
            "tsConfig": "projects/angular17-demo/tsconfig.spec.json",
            "karmaConfig": "projects/angular17-demo/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/angular17-demo/src/favicon.ico",
              "projects/angular17-demo/src/assets"
            ],
            "styles": ["projects/angular17-demo/src/styles.scss"],
            "scripts": []
          }
        }
      }
    }
  }
}
